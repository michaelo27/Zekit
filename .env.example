# ZeKit Environment Configuration (Testnet Default)
# Copy this file locally to `.env` — NEVER commit secret keys or seed phrases.

# Network: testnet | mainnet | regtest
ZEKIT_NETWORK=testnet

# Zcash lightwalletd gRPC endpoint (Testnet default)
ZEKIT_LIGHTWALLETD_URL=https://lightwalletd.testnet.electriccoin.co:9067

# Local encrypted/SQLite wallet data directory
ZEKIT_DATA_DIR=.zekit/testnet

# Logging verbosity (error | warn | info | debug | trace)
RUST_LOG=zekit=info
