{
  "name": "zekit-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "ZeKit — Shielded Tx in Minutes. Stop integrating 8 components. Use one kit.",
  "license": "MIT",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "build:wasm": "wasm-pack build packages/zekit-ts --target web --out-dir pkg",
    "build:ts": "pnpm --filter zekit-ts build",
    "dev:playground": "pnpm --filter @zekit/playground dev",
    "build:playground": "pnpm --filter @zekit/playground build",
    "typecheck": "pnpm -r typecheck",
    "clean": "rm -rf target packages/zekit-ts/dist packages/zekit-ts/pkg apps/playground/dist"
  }
}